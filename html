<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Hasha — AI Teacher</title>
<style>
  :root{
    --board-900:#0f2a24;
    --board-800:#153a32;
    --board-700:#1e4d43;
    --chalk:#f4efe2;
    --chalk-dim:#cfd8c9;
    --amber:#e8a33d;
    --amber-dim:#8a6a35;
    --coral:#e0685a;
    --sky:#5fb7c9;
    --line: rgba(244,239,226,0.14);
    --serif: "Iowan Old Style","Palatino Linotype",Palatino,Georgia,serif;
    --sans: -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
    --mono: "SFMono-Regular",Consolas,"Liberation Mono",Menlo,monospace;
  }
  *{box-sizing:border-box;}
  html,body{height:100%;}
  body{
    margin:0;
    background:
      radial-gradient(ellipse at top left, rgba(232,163,61,0.06), transparent 55%),
      var(--board-900);
    color:var(--chalk);
    font-family:var(--sans);
    min-height:100vh;
  }
  .app{max-width:1040px;margin:0 auto;padding:28px 20px 60px;}
  header.top{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:22px;border-bottom:1px solid var(--line);padding-bottom:16px;}
  .brand{display:flex;align-items:baseline;gap:10px;}
  .brand h1{font-family:var(--serif);font-weight:600;font-size:28px;margin:0;letter-spacing:0.2px;}
  .brand span.tag{color:var(--chalk-dim);font-size:13px;}
  .profile-chip{font-size:12px;color:var(--chalk-dim);background:var(--board-800);border:1px solid var(--line);padding:6px 12px;border-radius:100px;}
 
  .panel{background:var(--board-800);border:1px solid var(--line);border-radius:6px;padding:24px;margin-bottom:18px;}
  .panel h2{font-family:var(--serif);font-weight:600;font-size:20px;margin:0 0 14px;}
  label{display:block;font-size:13px;color:var(--chalk-dim);margin:14px 0 6px;}
  label:first-child{margin-top:0;}
  textarea,input[type=text],select{
    width:100%;background:var(--board-900);border:1px solid var(--line);color:var(--chalk);
    padding:10px 12px;border-radius:4px;font-size:14.5px;font-family:var(--sans);
  }
  textarea{min-height:90px;resize:vertical;line-height:1.5;}
  .row{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
  .row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;}
  .pillgroup{display:flex;flex-wrap:wrap;gap:8px;}
  .pill{
    padding:7px 14px;border-radius:100px;border:1px solid var(--line);background:transparent;
    color:var(--chalk-dim);font-size:13px;cursor:pointer;transition:all .15s;
  }
  .pill.active{background:var(--amber);border-color:var(--amber);color:#1a1207;font-weight:600;}
  .pill:hover:not(.active){border-color:var(--amber-dim);color:var(--chalk);}
  button.primary{
    background:var(--amber);color:#1a1207;border:none;padding:12px 22px;border-radius:4px;
    font-size:14.5px;font-weight:700;cursor:pointer;margin-top:18px;letter-spacing:0.2px;
  }
  button.primary:disabled{opacity:0.45;cursor:default;}
  button.primary:hover:not(:disabled){background:#f2b358;}
  button.ghost{
    background:transparent;border:1px solid var(--line);color:var(--chalk-dim);
    padding:9px 16px;border-radius:4px;font-size:13.5px;cursor:pointer;
  }
  button.ghost:hover{border-color:var(--amber-dim);color:var(--chalk);}
 
  /* teaching room layout */
  .room{display:grid;grid-template-columns:220px 1fr;gap:20px;}
  .avatar-col{display:flex;flex-direction:column;align-items:center;gap:12px;}
  .avatar-wrap{width:180px;height:180px;border-radius:50%;background:radial-gradient(circle at 35% 30%, var(--board-700), var(--board-900));border:1px solid var(--line);display:flex;align-items:center;justify-content:center;}
  .speak-status{font-size:12px;color:var(--sky);min-height:16px;text-align:center;}
  .progress-list{width:100%;font-size:12px;color:var(--chalk-dim);margin-top:6px;}
  .progress-list .step{padding:5px 8px;border-radius:4px;margin-bottom:3px;border-left:2px solid transparent;}
  .progress-list .step.done{color:var(--sky);border-left-color:var(--sky);}
  .progress-list .step.current{color:var(--amber);border-left-color:var(--amber);background:rgba(232,163,61,0.08);}
 
  .stage{min-height:340px;}
  .concept-title{font-family:var(--serif);font-size:22px;margin:0 0 4px;}
  .concept-meta{font-size:12px;color:var(--amber-dim);margin-bottom:14px;}
  .explain-text{font-size:15.5px;line-height:1.7;color:var(--chalk);margin-bottom:16px;white-space:pre-wrap;}
  .grounding-note{font-size:11.5px;color:var(--chalk-dim);border-left:2px solid var(--sky);padding:6px 10px;margin-bottom:16px;background:rgba(95,183,201,0.06);}
 
  .visual-box{background:var(--board-900);border:1px solid var(--line);border-radius:6px;padding:16px;margin-bottom:18px;}
  .visual-box svg{width:100%;height:auto;display:block;}
  .visual-box pre{margin:0;font-family:var(--mono);font-size:13px;color:var(--sky);white-space:pre-wrap;}
  .visual-box .out{margin-top:8px;font-family:var(--mono);font-size:12px;color:var(--chalk-dim);border-top:1px dashed var(--line);padding-top:8px;}
 
  .question-box{border-top:1px solid var(--line);padding-top:16px;}
  .qtext{font-size:15px;margin-bottom:12px;color:var(--chalk);}
  .options{display:flex;flex-direction:column;gap:8px;margin-bottom:12px;}
  .opt{
    text-align:left;padding:10px 14px;border:1px solid var(--line);border-radius:4px;background:transparent;
    color:var(--chalk);cursor:pointer;font-size:14px;
  }
  .opt:hover{border-color:var(--amber-dim);}
  .opt.selected{border-color:var(--amber);background:rgba(232,163,61,0.08);}
  .opt.correct{border-color:var(--sky);background:rgba(95,183,201,0.1);}
  .opt.wrong{border-color:var(--coral);background:rgba(224,104,90,0.1);}
 
  .feedback{margin-top:14px;padding:12px 14px;border-radius:4px;font-size:14px;line-height:1.6;}
  .feedback.correct{background:rgba(95,183,201,0.08);border-left:3px solid var(--sky);}
  .feedback.wrong{background:rgba(224,104,90,0.08);border-left:3px solid var(--coral);}
 
  .loading{color:var(--chalk-dim);font-size:14px;font-style:italic;}
  .loading::after{content:"";display:inline-block;width:6px;}
 
  .report-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:10px;}
  .report-card{background:var(--board-900);border:1px solid var(--line);border-radius:6px;padding:16px;}
  .report-card h3{margin:0 0 8px;font-size:13px;color:var(--chalk-dim);text-transform:none;}
  .score-big{font-family:var(--serif);font-size:40px;color:var(--amber);}
  .taglist{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px;}
  .tag{font-size:12px;padding:4px 10px;border-radius:100px;border:1px solid var(--line);}
  .tag.strong{color:var(--sky);border-color:rgba(95,183,201,0.4);}
  .tag.weak{color:var(--coral);border-color:rgba(224,104,90,0.4);}
 
  .langbar{display:flex;gap:8px;align-items:center;margin-bottom:16px;}
  .langbar span{font-size:12px;color:var(--chalk-dim);}
  textarea:focus,input:focus,select:focus,button:focus-visible{outline:2px solid var(--amber);outline-offset:1px;}
</style>
</head>
